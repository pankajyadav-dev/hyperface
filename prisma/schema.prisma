// =====================================================================
//  Prisma schema — Hyperface Meeting Room Booking
// ---------------------------------------------------------------------
//  The base tables/columns are modelled here. The extra integrity rules
//  that Prisma cannot express directly — the anti-double-booking
//  EXCLUDE constraint and the generated `during` range column — live in
//  the hand-written migration at prisma/migrations/0001_init. Prisma
//  never reads that column, so the two stay compatible.
//
//  Upgrade-friendly choices: surrogate int keys, status enum (we cancel
//  by flipping status, we never delete), created/updated timestamps,
//  and RESTRICT foreign keys so history can't be orphaned.
// =====================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  bookings  Booking[]

  @@map("employees")
}

model Room {
  id        Int       @id @default(autoincrement())
  name      String
  floor     Int
  capacity  Int
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  bookings  Booking[]

  @@map("rooms")
}

enum BookingStatus {
  booked
  cancelled

  @@map("booking_status")
}

model Booking {
  id          Int           @id @default(autoincrement())
  roomId      Int           @map("room_id")
  employeeId  Int           @map("employee_id")
  bookingDate DateTime      @map("booking_date") @db.Date
  startTime   DateTime      @map("start_time") @db.Time(0)
  endTime     DateTime      @map("end_time") @db.Time(0)
  attendees   Int
  title       String?
  status      BookingStatus @default(booked)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  cancelledAt DateTime?     @map("cancelled_at")

  room     Room     @relation(fields: [roomId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([roomId, bookingDate])
  @@index([employeeId])
  @@index([status, bookingDate])
  @@map("bookings")
}
