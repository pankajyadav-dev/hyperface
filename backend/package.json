{
  "name": "hyperface-rooms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Hyperface meeting-room booking tool",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "cors": "2.8.5",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "prisma": "6.3.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
